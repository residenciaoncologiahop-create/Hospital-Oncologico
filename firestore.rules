rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares de autenticacion y autoria
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(doctorId) {
      return isAuthenticated() && request.auth.uid == doctorId;
    }

    // 1. Coleccion patients
    match /patients/{patientId} {
      // Crear: solo si esta autenticado y se asigna como doctorId propio
      allow create: if isAuthenticated() && request.resource.data.doctorId == request.auth.uid;
      
      // Leer: solo si el paciente pertenece al medico autenticado
      allow read: if isOwner(resource.data.doctorId);
      
      // Actualizar: solo el medico propietario y manteniendo el doctorId inalterado
      allow update: if isOwner(resource.data.doctorId) && request.resource.data.doctorId == request.auth.uid;
      
      // Eliminar: solo el medico propietario
      allow delete: if isOwner(resource.data.doctorId);
    }

    // 2. Coleccion pendientes
    match /pendientes/{pendienteId} {
      // Crear: solo si esta autenticado y doctorId es propio
      allow create: if isAuthenticated() && request.resource.data.doctorId == request.auth.uid;
      
      // Leer: solo tareas propias
      allow read: if isOwner(resource.data.doctorId);
      
      // Actualizar: solo tareas propias y manteniendo doctorId
      allow update: if isOwner(resource.data.doctorId) && request.resource.data.doctorId == request.auth.uid;
      
      // Eliminar: solo tareas propias
      allow delete: if isOwner(resource.data.doctorId);
    }

    // 3. Coleccion audit_logs (Inmutable, solo anexado por usuarios autenticados)
    match /audit_logs/{logId} {
      // Crear: usuarios autenticados pueden registrar eventos de auditoria
      allow create: if isAuthenticated();
      
      // Leer, actualizar y borrar: totalmente prohibido desde el cliente para preservar inmutabilidad
      allow read, update, delete: if false;
    }

    // 4. Coleccion clinical_trials (Registro publico de ensayos sincronizado temporalmente por el cliente)
    match /clinical_trials/{trialId} {
      // Lectura: todos los usuarios autenticados
      allow read: if isAuthenticated();
      
      // Escritura: usuarios autenticados pueden sincronizar estudios desde las fuentes publicas
      // El borrado desde cliente queda expresamente bloqueado
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Denegacion por defecto para cualquier otra coleccion no declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
